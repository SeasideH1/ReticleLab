<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp><UseUwpTools>false</UseUwpTools><EnableMsixTooling>false</EnableMsixTooling>
    <SelfContained>true</SelfContained><PublishAot>false</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Reticle.Widget</RootNamespace><AssemblyName>ReticleWidget</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <CsWinRTIncludes>Microsoft.Gaming.XboxGameBar</CsWinRTIncludes>
    <CsWinRTWindowsMetadata>$(NuGetPackageRoot)\microsoft.windows.sdk.net.ref\10.0.26100.57\winmd</CsWinRTWindowsMetadata>
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <CsWinRTInputs Include="$(NuGetPackageRoot)\microsoft.gaming.xboxgamebar\7.3.2607010\lib\uap10.0\Microsoft.Gaming.XboxGameBar.winmd" />
    <CsWinRTInputs Include="$(SystemRoot)\System32\WinMetadata\Windows.UI.Xaml.winmd" />
    <ProjectReference Include="../Core/Core.csproj" />
    <PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="7.3.2607010" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" PrivateAssets="all" />
    <Content Include="Assets\**\*" />
    <Content Include="Fonts\*.ttf" />
    <Content Include="Bridge\**\*" />
  </ItemGroup>
</Project>
